{
  "name": "zju4nn-hub",
  "version": "0.2.33",
  "description": "zJu4nn Hub — App desktop com catálogo de jogos verdes, downloads e biblioteca",
  "author": {
    "name": "zJu4nn",
    "email": "contato@zju4nn.gg"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-from-site.js",
    "predev": "npm run sync",
    "dev": "electron .",
    "release": "node scripts/release-with-dns-fix.cjs",
    "release-direct": "npm run sync && electron-builder --win --publish=always --config.npmRebuild=false && node scripts/publish-release-notes.js",
    "publish-notes": "node scripts/publish-release-notes.js",
    "build": "electron-builder --win --config.npmRebuild=false"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "archiver": "^7.0.1",
    "check-disk-space": "^3.4.0",
    "electron-updater": "^6.8.3",
    "js-yaml": "^4.1.1",
    "webtorrent": "^2.8.5",
    "ws": "^8.20.0",
    "yauzl": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  }
}
